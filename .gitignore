__pycache__/
*.pyc
.pytest_cache/
.coverage
mcp_server/journal.jsonl
mcp_server/journal_*.jsonl
mcp_server/rag_store/
web/certs/
.env
CISO*.txt
~$*.docx
.claude/

# Real-model qualification artifacts (spec: "Add the generated artifact
# directory to .gitignore, while keeping any schema or empty placeholder
# directory needed by the project") -- generated by tests/test_real_model_generator.py
# / scripts/evaluate_real_model_results.py, never committed (they reflect
# one local run against one specific model/server, not a repo-tracked fact).
artifacts/real_model/*.json
artifacts/real_model/*.md
!artifacts/real_model/.gitkeep
artifacts/docker_validation/*.json
!artifacts/docker_validation/.gitkeep

# Local-only, not repo facts: GGUF model weights (multi-GB binaries, fetched
# separately per docker-compose.yml's own instructions) and a full local
# llama.cpp source checkout (superseded by the prebuilt Docker image
# ghcr.io/ggml-org/llama.cpp:server; never imported by this repo's own code).
models/
llama.cpp/

# Leftover local debug artifacts from running llama-server outside Docker.
fichier.txt
llama-server-stderr.log
llama-server-stdout.log

# Generated docker compose config snapshot (docker compose config output) --
# bakes in a machine-specific absolute path, never meant to be hand-edited or
# deployed from directly. Regenerate via:
#   docker compose -f docker-compose.yml -f docker-stack.yml config
docker-stack-merged.yml
