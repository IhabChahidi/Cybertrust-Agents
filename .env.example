# Copy to .env (gitignored) and fill in real values. Never commit .env.

# --- Dashboard dev auth (web/auth.py) ---------------------------------------
CISO_DEV_USERNAME=ciso
CISO_DEV_PASSWORD=change-me
DELEGATE_DEV_USERNAME=ciso.delegate
DELEGATE_DEV_PASSWORD=change-me

# --- MCP pipeline (mcp_server/config.py) ------------------------------------
MCP_LLM_MODE=mock
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
GENERATOR_OLLAMA_MODEL=qwen2.5:7b-instruct
VERIFIER_OLLAMA_MODEL=llama3.1

# --- Optional local RAG layer for the Generator (mcp_server/rag/) ----------
# Off by default; the Generator behaves exactly as before when this is false.
RAG_ENABLED=false

# Local embeddings (mcp_server/rag/embeddings.py) -- no external embedding API.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ChromaDB (mcp_server/rag/chroma_client.py). Leave CHROMA_HOST unset to use a
# local on-disk store (CHROMA_PERSIST_DIR) -- no server required. Set
# CHROMA_HOST to point at a real Chroma server (e.g. in Docker Compose) instead.
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=cybertrust
CHROMA_PERSIST_DIR=mcp_server/rag_store

# Retrieval tuning (mcp_server/rag/config.py)
RAG_VECTOR_TOP_K=12
RAG_FINAL_TOP_K=8
RAG_MAX_CONTEXT_TOKENS=5000
RAG_MIN_SCORE=0.35

# --- llama.cpp Generator (Foundation-Sec-8B-Instruct.Q4_K_M.gguf) ----------
# mcp_server/llamacpp_config.py / mcp_server/llm_roles/llamacpp_client.py.
# This is a SEPARATE backend from OLLAMA_* above -- used only by the new
# /api/v1/generator/claims endpoint (web/generator_api.py), not by the
# existing mcp_server/llm_roles/llama_generator.py pipeline.
GENERATOR_BASE_URL=http://llama-generator:8080/v1
GENERATOR_MODEL_NAME=foundation-sec-generator
# Path as mounted INSIDE the llama-generator container (docker-compose.yml
# mounts ./models read-only at /models) -- the file is never downloaded
# automatically; place it there yourself before starting the stack. Verified
# real source: https://huggingface.co/mradermacher/Foundation-Sec-8B-Instruct-GGUF
# (the base, non-instruct fdtn-ai/Foundation-Sec-8B-Q4_K_M-GGUF produces
# incoherent chat output -- confirmed by live testing -- do not use it here).
GENERATOR_MODEL_PATH=/models/Foundation-Sec-8B-Instruct.Q4_K_M.gguf
GENERATOR_CONTEXT_SIZE=8192
GENERATOR_MAX_OUTPUT_TOKENS=1200
GENERATOR_TEMPERATURE=0.1
GENERATOR_TOP_P=0.9
GENERATOR_SEED=42
GENERATOR_TIMEOUT_SECONDS=300
LLAMA_THREADS=8
# 0 = CPU-only. Set > 0 only if the llama.cpp build/container has GPU support.
LLAMA_GPU_LAYERS=0

# Structured-output mode (mcp_server/llm_roles/llamacpp_client.py):
#   auto        - probe the configured server once; json_schema if supported, else json_object (default)
#   json_schema - require JSON-Schema-constrained output; readiness fails if the server doesn't support it
#   json_object - always use the original response_format={"type":"json_object"} behavior
#   disabled    - no response_format at all; Pydantic/citation validation still applies
GENERATOR_STRUCTURED_OUTPUT_MODE=auto

# --- Generator/RAG API auth (web/generator_api.py) --------------------------
# Distinct from the CISO dashboard's session-cookie auth above -- this
# machine-to-machine API surface (ingestion/retrieval/generator endpoints) is
# protected by a static header key instead. Change API_KEY before any
# non-local deployment.
API_KEY_HEADER=X-API-Key
API_KEY=change-me

# In-memory ingestion job cap (mcp_server/rag/jobs.py) -- oldest completed
# jobs are evicted first once this many are tracked; non-durable across
# restarts by design (documented pilot limitation, see README).
GENERATOR_MAX_JOBS=1000
